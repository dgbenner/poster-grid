  "facts": {
    "pin": {
      "title": "Portmeirion",
      "description": "Village in Wales",
      "extract": "Portmeirion is a folly Italianate style tourist village in Gwynedd, North Wales. It lies on the estuary of the River Dwyryd in the community of Penrhyndeudraeth, 2 miles (3.2 km) from Porthmadog and 1 mile (1.6 km) from Minffordd railway station.",
      "url": "https://en.wikipedia.org/wiki/Portmeirion",
      "coordinates": {
        "lat": 52.91305556,
        "lng": -4.09916667
      },
      "km": 0,
      "matchedBy": "title",
      "leadImage": "https://thumb.wikimedia.org/wikipedia/commons/thumb/2/25/Portmeirion%2C_Wales_%2848559387366%29.jpg/3840px-Portmeirion%2C_Wales_%2848559387366%29.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Penrhyndeudraeth",
      "description": "Town in Gwynedd, Wales",
      "extract": "Penrhyndeudraeth is a small town and community in the Welsh county of Gwynedd. The town is close to the mouth of the River Dwyryd on the A487 nearly 3 miles (4.8 km) east of Porthmadog, and had a population of 2,150 at the 2011 census, increased from 2,031 in 2001. The community includes the villages of Minffordd and Portmeirion.",
      "url": "https://en.wikipedia.org/wiki/Penrhyndeudraeth",
      "coordinates": {
        "lat": 52.929,
        "lng": -4.066
      },
      "km": 2.8,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/a/ac/Penrhyndeudraeth_2007.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    }
  },
  "note": {
    "text": "Italianate village designed by Clough Williams-Ellis, famous as the filming location for The Prisoner.",
