    "pin": {
      "title": "Monumental Cemetery of Staglieno",
      "description": "Cemetery in Genoa, Italy",
      "extract": "The Cimitero monumentale di Staglieno is an extensive monumental cemetery located on a hillside in the district of Staglieno of Genoa, Italy, famous for its monumental sculpture. Covering an area of more than a square kilometre, it is one of the largest cemeteries in Europe.",
      "url": "https://en.wikipedia.org/wiki/Monumental_Cemetery_of_Staglieno",
      "coordinates": {
        "lat": 44.430156,
        "lng": 8.950327
      },
      "km": 0.5,
      "matchedBy": "search",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/7/70/Genova-Staglieno-IMG_2008.JPG?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Genoa",
      "description": "Largest city in Liguria, Italy",
      "extract": "Genoa is the sixth-largest city in Italy and the capital of the region of Liguria in northern Italy. As of 2026, 566,247 people live within the city's administrative limits. While its metropolitan city has 820,691 inhabitants, more than 1.5 million people live in the wider metropolitan area stretching along the Italian Riviera.",
      "url": "https://en.wikipedia.org/wiki/Genoa",
      "coordinates": {
        "lat": 44.40722222,
        "lng": 8.93388889
      },
      "km": 3.3,
      "matchedBy": "title",
      "leadImage": "https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0d/Piazza_de_Ferrari%2C_Genoa.jpg/3840px-Piazza_de_Ferrari%2C_Genoa.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "source": "Wikipedia"
    }
