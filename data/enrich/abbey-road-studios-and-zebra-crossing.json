  "facts": {
    "pin": {
      "title": "Abbey Road Studios",
      "description": "Recording studio in London, England",
      "extract": "Abbey Road Studios is a music recording studio at 3 Abbey Road, St John's Wood, City of Westminster, London. It was established in November 1931 by the Gramophone Company, a predecessor of British music company EMI, which owned it until Universal Music Group (UMG) took control of part of it in 2013. It is ultimately owned by UMG's subsidiary Virgin Records.",
      "url": "https://en.wikipedia.org/wiki/Abbey_Road_Studios",
