    "pin": {
      "title": "Marksburg",
      "description": "Castle in Braubach, Rhineland-Palatinate, Germany",
      "extract": "The Marksburg is a castle above the town of Braubach in Rhineland-Palatinate, Germany. It is one of the principal sites of the Rhine Gorge UNESCO World Heritage Site. The fortress was used for protection rather than as a residence for royal families. It has a striking example of a bergfried designed as a butter-churn tower. Of the 40 hill castles between Bingen am Rhein and Koblenz the Marksburg was one of only two which was never destroyed, and the only one that never fell into disrepair.",
      "url": "https://en.wikipedia.org/wiki/Marksburg",
      "coordinates": {
        "lat": 50.27180556,
        "lng": 7.64916667
      },
      "km": 0.3,
      "matchedBy": "title",
      "leadImage": "https://thumb.wikimedia.org/wikipedia/commons/thumb/0/02/Marksburg-Braubach.jpg/3840px-Marksburg-Braubach.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Braubach",
      "description": "Town in Rhineland-Palatinate, Germany",
      "extract": "Braubach is a municipality in the Rhein-Lahn-Kreis, in Rhineland-Palatinate, Germany. It is situated on the right bank of the Rhine, approx. 10 km southeast of Koblenz. Braubach has assorted medieval architecture intact, including portions of the town wall, half-timbered buildings, and castle Marksburg on the hill above.",
      "url": "https://en.wikipedia.org/wiki/Braubach",
      "coordinates": {
        "lat": 50.27472222,
        "lng": 7.64611111
      },
      "km": 0.2,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/e/ef/Braubach_-_Schlankes_Fachwerkhaus_in_engen_Gassen.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    }
  },
