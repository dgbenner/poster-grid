  "facts": {
    "pin": {
      "title": "Camera Obscura, Edinburgh",
      "description": "Tourist attraction in Scotland",
      "extract": "Camera Obscura & World of Illusions is a tourist attraction located in Outlook Tower on the Castlehill section of the Royal Mile close to Edinburgh Castle. The original attraction was founded by entrepreneur Maria Theresa Short in 1835 and was exhibited on Calton Hill. Outlook Tower has been a museum since the late 1890s and is currently home to many interactive exhibits, including the original camera obscura.",
      "url": "https://en.wikipedia.org/wiki/Camera_Obscura%2C_Edinburgh",
      "coordinates": {
        "lat": 55.949,
        "lng": -3.1956
      },
      "km": 0,
      "matchedBy": "search",
      "leadImage": "https://upload.wikimedia.org/wikipedia/en/0/0d/Camera_Obscura_Edinburgh_Logo.png?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Edinburgh",
      "description": "Capital city of Scotland",
      "extract": "Edinburgh is the capital city of Scotland and one of its 32 council areas. It is located in southeast Scotland and is bounded to the north by the Firth of Forth and to the south by the Pentland Hills. Edinburgh had a population of\n506,520 in 2020, making it the second-most-populous city in Scotland and the seventh-most-populous in the United Kingdom. The wider metropolitan area had a population of 912,490 in the same year.",
      "url": "https://en.wikipedia.org/wiki/Edinburgh",
      "coordinates": {
        "lat": 55.95333333,
        "lng": -3.18916667
      },
      "km": 0.6,
