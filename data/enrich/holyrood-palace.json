  "facts": {
    "pin": {
      "title": "Holyrood Abbey",
      "description": "Architectural structure in Edinburgh",
      "extract": "Holyrood Abbey is a ruined abbey of the Canons Regular in Edinburgh, Scotland. The abbey was founded in 1128 by David I of Scotland. During the 15th century, the abbey guesthouse was developed into a \nroyal residence, and after the Scottish Reformation the Palace of Holyroodhouse was expanded further. The abbey church was used as a parish church until the 17th century, and has been ruined since the 18th century. The remaining walls of the abbey lie adjacent to the palace, at the eastern end of Edinburgh's Royal Mile. The site of the abbey is protected as a scheduled monument.",
      "url": "https://en.wikipedia.org/wiki/Holyrood_Abbey",
      "coordinates": {
        "lat": 55.9531,
        "lng": -3.1716
      },
      "km": 0.1,
      "matchedBy": "search",
      "leadImage": "https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f0/Holyrood_Abbey_14.jpg/3840px-Holyrood_Abbey_14.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Edinburgh",
      "description": "Capital city of Scotland",
      "extract": "Edinburgh is the capital city of Scotland and one of its 32 council areas. It is located in southeast Scotland and is bounded to the north by the Firth of Forth and to the south by the Pentland Hills. Edinburgh had a population of\n506,520 in 2020, making it the second-most-populous city in Scotland and the seventh-most-populous in the United Kingdom. The wider metropolitan area had a population of 912,490 in the same year.",
      "url": "https://en.wikipedia.org/wiki/Edinburgh",
      "coordinates": {
        "lat": 55.95333333,
        "lng": -3.18916667
      },
      "km": 1.1,
      "matchedBy": "title",
      "leadImage": "https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Skyline_of_Edinburgh.jpg/3840px-Skyline_of_Edinburgh.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "source": "Wikipedia"
    }
  },
