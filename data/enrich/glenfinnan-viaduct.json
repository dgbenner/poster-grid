  "facts": {
    "pin": {
      "title": "Glenfinnan Viaduct",
      "description": "Railway viaduct in the Highlands, Scotland",
      "extract": "The Glenfinnan Viaduct is a railway viaduct on the West Highland Line at Glenfinnan, in the Lochaber district of north-western Scotland, built from 1897 to 1901. Located at the top of Loch Shiel in the West Scottish Highlands, the viaduct overlooks the Glenfinnan Monument and the waters of Loch Shiel.",
      "url": "https://en.wikipedia.org/wiki/Glenfinnan_Viaduct",
      "coordinates": {
        "lat": 56.876285,
        "lng": -5.431914
      },
      "km": 0.2,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/1/10/Glenfinnan_Viaduct_-_2022.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Glenfinnan",
      "description": "Human settlement in Scotland",
      "extract": "Glenfinnan is a hamlet in Lochaber area of the Highlands of Scotland. In 1745 the Jacobite rising began here when Prince Charles Edward Stuart raised his standard on the shores of Loch Shiel. Seventy years later, the 18 m (60 ft) Glenfinnan Monument, at the head of the loch, was erected to commemorate the historic event.",
      "url": "https://en.wikipedia.org/wiki/Glenfinnan",
      "coordinates": {
        "lat": 56.87083333,
        "lng": -5.44638889
      },
      "km": 1.2,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/f/f4/Glenfinnanmonument-wyrd-5214.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    }
  },
  "note": {
    "text": "Curved 21-arch railway viaduct over Glenfinnan, famous from the Harry Potter films' Hogwarts Express scenes.",
