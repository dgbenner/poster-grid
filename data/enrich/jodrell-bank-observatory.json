      "matchedBy": "title",
      "leadImage": "https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/Goostrey_-_St_Luke%27s_Church_-_geograph.org.uk_-_6325754.jpg/3840px-Goostrey_-_St_Luke%27s_Church_-_geograph.org.uk_-_6325754.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "source": "Wikipedia"
    }
