  "facts": {
    "pin": {
      "title": "The Shambles",
      "description": "Street in York, England",
      "extract": "The Shambles is a historic street in York, England, featuring preserved medieval buildings, some dating to the 14th century. Running between Newgate in the north and Pavement in the south, the street is narrow, with many timber-framed buildings with jettied floors which overhang the street by several feet. It was once known as the \"Great Flesh Shambles\", a name reflecting its historical use as a butchers' street. The word shambles derives from Old English sċeamol, referring to vendors' or butchers' stalls. In 1885, thirty-one butchers' shops were located along the street, but none remain today.",
      "url": "https://en.wikipedia.org/wiki/The_Shambles",
      "coordinates": {
        "lat": 53.95940278,
        "lng": -1.08011111
      },
      "km": 0.1,
      "matchedBy": "search",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/a/aa/Shambles_shopper_8686.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    },
    "town": {
      "title": "York",
      "description": "City in North Yorkshire, England",
      "extract": "York is a cathedral city in North Yorkshire, England, with Roman origins, sited at the confluence of the rivers Ouse and Foss. It has many historic buildings and other structures, including the minster, castle and city walls, all of which are Grade I listed. It is the traditional county town of Yorkshire, and the administrative centre of the City of York district. It is located 27 miles (43 km) north-east of Leeds, 90 miles (140 km) south of Newcastle upon Tyne and 207 miles (333 km) north of London. York's built-up area had a recorded population of 141,685 at the 2021 census.",
      "url": "https://en.wikipedia.org/wiki/York",
      "coordinates": {
        "lat": 53.96,
        "lng": -1.08
      },
      "km": 0.1,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/1/14/York_Minster_%282797690%29.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    }
  },
  "note": {
    "text": "Lurching medieval butchers’ street; the ‘Diagon Alley’ of York.",
