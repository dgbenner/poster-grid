  "facts": {
    "pin": {
      "title": "Halnaker",
      "description": "Hamlet in West Sussex, England",
      "extract": "Halnaker is a hamlet in the Chichester district of West Sussex, England. It lies on the A285 road 3.5 miles (5.6 km) north-east of Chichester, where it follows the line of the Roman road to London called Stane Street. There is a pub called The Anglesey Arms. Goodwood House is north-west of the village. North-east of the village Halnaker Windmill stands on 128 metre/420 feet high Halnaker Hill, a southern outpost of the South Downs. It is in the civil parish of Boxgrove.",
      "url": "https://en.wikipedia.org/wiki/Halnaker",
      "coordinates": {
        "lat": 50.86508,
        "lng": -0.71193
      },
      "km": 1,
      "matchedBy": "nearby article",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/e/e8/Halnaker_Windmill.JPG?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Chichester",
      "description": "City in West Sussex, England",
      "extract": "Chichester is a cathedral city and civil parish in the Chichester district of West Sussex, England. It is the only city in West Sussex and is its county town. In 2021 the parish had a population of 29,407. It was a Roman and Anglo-Saxon settlement and a major market town from those times through Norman and medieval times to the present day. It is the seat of the Church of England Diocese of Chichester and is home to a 12th-century cathedral.",
      "url": "https://en.wikipedia.org/wiki/Chichester",
