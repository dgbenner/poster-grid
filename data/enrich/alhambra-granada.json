    "pin": {
      "title": "Alhambra",
      "description": "Palace and fortress complex in Granada, Spain",
      "extract": "The Alhambra is a palace and fortress complex located in Granada, Spain. It is one of the most famous monuments of Islamic architecture and the only well-preserved palace from the medieval Islamic world. Additionally, the palace contains notable examples of Spanish Renaissance architecture.",
      "url": "https://en.wikipedia.org/wiki/Alhambra",
      "coordinates": {
