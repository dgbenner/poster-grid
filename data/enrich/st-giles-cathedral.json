  "facts": {
    "pin": {
      "title": "St Giles' Cathedral",
      "description": "Church in Edinburgh, Scotland",
      "extract": "St Giles' Cathedral, also known as the High Kirk of Edinburgh, is one of three cathedrals in Edinburgh, Scotland. The existing building was begun in the 14th century and extended until the early 16th century; significant alterations were undertaken in the 19th and 20th centuries, including the addition of the Thistle Chapel. St Giles' is closely associated with many events and figures in Scottish history, including John Knox, who served as the church's minister after the Scottish Reformation. The cathedral is administered by the Church of Scotland.",
      "url": "https://en.wikipedia.org/wiki/St_Giles'_Cathedral",
      "coordinates": {
        "lat": 55.94944444,
        "lng": -3.19083333
      },
      "km": 0,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/a/a0/St_Giles_Cathedral_-_01.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Edinburgh",
      "description": "Capital city of Scotland",
      "extract": "Edinburgh is the capital city of Scotland and one of its 32 council areas. It is located in southeast Scotland and is bounded to the north by the Firth of Forth and to the south by the Pentland Hills. Edinburgh had a population of\n506,520 in 2020, making it the second-most-populous city in Scotland and the seventh-most-populous in the United Kingdom. The wider metropolitan area had a population of 912,490 in the same year.",
      "url": "https://en.wikipedia.org/wiki/Edinburgh",
      "coordinates": {
        "lat": 55.95333333,
        "lng": -3.18916667
      },
      "km": 0.4,
