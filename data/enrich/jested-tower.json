  "facts": {
    "pin": {
      "title": "Ještěd Tower",
      "description": "Television transmitter and hotel near Liberec, Czech Republic",
      "extract": "Ještěd Tower is a television transmitter on top of Mount Ještěd near Liberec in the Czech Republic. Measuring 94 m (308 ft), it is made of reinforced concrete shaped in a \"hyperboloid\" form. The tower was designed by architect Karel Hubáček, who was assisted by Zdeněk Patrman, involved in building statics, and by Otakar Binar, who designed the interior furnishing. It took the team three years to finalize the structure design (1963–1966). The construction itself took seven years to finish (1966–1973).",
      "url": "https://en.wikipedia.org/wiki/Je%C5%A1t%C4%9Bd_Tower",
      "coordinates": {
        "lat": 50.73222222,
        "lng": 14.98527778
      },
      "km": 0.1,
      "matchedBy": "title",
      "leadImage": "https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Jested_002.JPG/1920px-Jested_002.JPG?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Liberec",
      "description": "City in the Czech Republic",
      "extract": "Liberec is a city in the Czech Republic. It has about 108,000 inhabitants, making it the fifth largest city in the country. It lies on the Lusatian Neisse River, in a basin surrounded by mountains. The city centre is well preserved and is protected as an urban monument zone.",
      "url": "https://en.wikipedia.org/wiki/Liberec",
      "coordinates": {
