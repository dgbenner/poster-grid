    "town": {
      "title": "Keswick, Cumbria",
      "description": "Town and civil parish in Cumbria, England",
      "extract": "Keswick is a market town and civil parish in the Cumberland unitary authority area of Cumbria, England. It lies within the Lake District National Park, just north of Derwentwater and 4 mi (6.4 km) from Bassenthwaite Lake. The parish had a population of 4,658 at the 2021 census.",
