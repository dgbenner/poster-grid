    "pin": {
      "title": "Cerne Abbas Giant",
      "description": "Hill figure near Cerne Abbas in Dorset",
      "extract": "The Cerne Abbas Giant, or Cerne Giant, is a hill figure near the village of Cerne Abbas, in Dorset, England. It is currently owned by the National Trust, and listed as a scheduled monument of England. Measuring 55 metres (180 ft) in length, the hill figure depicts a bald, nude male with a prominent erection, holding his left hand out to the side and wielding a large club in his right hand. Like many other hill figures, the Cerne Giant is formed by shallow trenches cut into the turf and backfilled with chalk rubble.",
      "url": "https://en.wikipedia.org/wiki/Cerne_Abbas_Giant",
      "coordinates": {
        "lat": 50.813676,
        "lng": -2.4747
      },
      "km": 0,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/0/02/Cerne-abbas-giant-2001-cropped.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Cerne Abbas",
      "description": "Village in Dorset, England",
      "extract": "Cerne Abbas is a village and civil parish in Dorset in southern England. It lies in the Dorset Council administrative area in the Cerne Valley in the Dorset Downs. The village lies just east of the A352 road 10 km (6 mi) north of Dorchester. At the 2021 census, the parish had a population of 858.",
      "url": "https://en.wikipedia.org/wiki/Cerne_Abbas",
      "coordinates": {
        "lat": 50.8095,
