    "pin": {
      "title": "Wartburg",
      "description": "Castle in Eisenach, Germany",
      "extract": "The Wartburg is a castle originally built in the Middle Ages. At an elevation of 410 metres (1,350 ft) in the state of Thuringia, Germany, it is situated on a southwest-facing precipice and overlooks the town of Eisenach to the north. It was the home of St. Elisabeth of Hungary, the place where Martin Luther translated the New Testament of the Bible into German, the site of the Wartburg festival of 1817 and the supposed setting for the possibly legendary Sängerkrieg. It was an important inspiration for Ludwig II when he decided to build Neuschwanstein Castle.",
      "url": "https://en.wikipedia.org/wiki/Wartburg",
      "coordinates": {
        "lat": 50.96611111,
        "lng": 10.30638889
      },
      "km": 0,
      "matchedBy": "title",
      "leadImage": "https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/Thuringia_Eisenach_asv2020-07_img23_Wartburg_Castle.jpg/3840px-Thuringia_Eisenach_asv2020-07_img23_Wartburg_Castle.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Eisenach",
      "description": "Town in Thuringia, Germany",
      "extract": "Eisenach is a town in Thuringia, Germany with 42,000 inhabitants, 50 kilometres west of Erfurt, 70 km southeast of Kassel and 150 km northeast of Frankfurt. It is the main urban centre of western Thuringia, and bordering northeastern Hessian regions, is near the former Inner German border. A major attraction is Wartburg castle, which has been a UNESCO World Heritage Site since 1999.",
      "url": "https://en.wikipedia.org/wiki/Eisenach",
