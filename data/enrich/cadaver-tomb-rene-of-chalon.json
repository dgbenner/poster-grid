      "source": "Wikipedia"
    },
    "town": {
      "title": "Bar-le-Duc",
      "description": "Prefecture and commune in Grand Est, France",
      "extract": "Bar-le-Duc, formerly known as Bar, is a commune in the Meuse département, of which it is the capital. The department is in Grand Est in northeastern France.",
      "url": "https://en.wikipedia.org/wiki/Bar-le-Duc",
