    "pin": {
      "title": "Falkirk Wheel",
      "description": "Rotating boat lift in Scotland",
      "extract": "The Falkirk Wheel is a rotating boat lift in Tamfourhill, Falkirk, in central Scotland, connecting the Forth and Clyde Canal with the Union Canal. It opened in 2002 as part of the Millennium Link project, reconnecting the two canals for the first time since the 1930s.",
      "url": "https://en.wikipedia.org/wiki/Falkirk_Wheel",
      "coordinates": {
        "lat": 56.00027778,
        "lng": -3.84166667
      },
      "km": 0.4,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/c/cd/FalkirkWheelSide_2004_SeanMcClean.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Stenhousemuir",
      "description": "Human settlement in Scotland",
      "extract": "Stenhousemuir is a town in the Central Lowlands of Scotland. It lies within the Falkirk council area of Scotland. The town is two miles north-northwest of Falkirk and directly adjoins to Larbert in the west, where the nearest rail access is located. The villages of Carron and Carronshore adjoin Stenhousemuir to the east but to a lesser extent. Historically, Stenhousemuir lies with the historic county of Stirlingshire. At the 2001 census it showed that it had a resident population of 10,351 but according to a 2009 estimate this was revised to around 10,190 residents. The combined population of the four localities in 2011 was 24,722, representing about 15% of the Falkirk council area total.",
      "url": "https://en.wikipedia.org/wiki/Stenhousemuir",
      "coordinates": {
        "lat": 56.028,
        "lng": -3.806
      },
      "km": 3.5,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/6/6f/Larbert_and_Stenhousemuir_from_the_air_%28geograph_5229642%29.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    }
  },
