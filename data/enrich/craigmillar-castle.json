  "facts": {
    "pin": {
      "title": "Craigmillar Castle",
      "description": "Castle in City of Edinburgh, Scotland",
      "extract": "Craigmillar Castle is a ruined medieval castle in Edinburgh, Scotland. It is three miles (4.8 km) south-east of the city centre, on a low hill to the south of the modern suburb of Craigmillar. The Preston family of Craigmillar, the local feudal barons, began building the castle in the late 14th century and building works continued through the 15th and 16th centuries. In 1660, the castle was sold to Sir John Gilmour, Lord President of the Court of Session, who breathed new life into the ageing castle. The Gilmours left Craigmillar in the 18th century for a more modern residence, nearby Inch House, and the castle fell into ruin. It is now in the care of Historic Environment Scotland as a scheduled monument, and is open to the public.",
      "url": "https://en.wikipedia.org/wiki/Craigmillar_Castle",
      "coordinates": {
        "lat": 55.9259,
        "lng": -3.1406
      },
      "km": 0.4,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/a/ae/Craigmillar_Castle.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Edinburgh",
      "description": "Capital city of Scotland",
      "extract": "Edinburgh is the capital city of Scotland and one of its 32 council areas. It is located in southeast Scotland and is bounded to the north by the Firth of Forth and to the south by the Pentland Hills. Edinburgh had a population of\n506,520 in 2020, making it the second-most-populous city in Scotland and the seventh-most-populous in the United Kingdom. The wider metropolitan area had a population of 912,490 in the same year.",
      "url": "https://en.wikipedia.org/wiki/Edinburgh",
