  "facts": {
    "pin": {
      "title": "Royal Botanic Garden Edinburgh",
      "description": "Botanical garden in Edinburgh, Scotland",
      "extract": "The Royal Botanic Garden Edinburgh (RBGE) is a scientific centre for the study of plants, their diversity and conservation, as well as a popular visitor attraction. Founded in 1670 as a physic garden to grow medicinal plants, today it occupies four sites across Scotland—Edinburgh, Dawyck, Logan and Benmore—each with its own specialist collection. The RBGE's living collection consists of more than 13,302 plant species, whilst the herbarium contains in excess of 3 million preserved specimens.",
      "url": "https://en.wikipedia.org/wiki/Royal_Botanic_Garden_Edinburgh",
      "coordinates": {
        "lat": 55.965,
        "lng": -3.21
      },
      "km": 0,
      "matchedBy": "search",
      "leadImage": "https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f8/Palm_House%2C_Royal_Botanic_Garden_Edinburgh.JPG/3840px-Palm_House%2C_Royal_Botanic_Garden_Edinburgh.JPG?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Edinburgh",
      "description": "Capital city of Scotland",
      "extract": "Edinburgh is the capital city of Scotland and one of its 32 council areas. It is located in southeast Scotland and is bounded to the north by the Firth of Forth and to the south by the Pentland Hills. Edinburgh had a population of\n506,520 in 2020, making it the second-most-populous city in Scotland and the seventh-most-populous in the United Kingdom. The wider metropolitan area had a population of 912,490 in the same year.",
      "url": "https://en.wikipedia.org/wiki/Edinburgh",
      "coordinates": {
        "lat": 55.95333333,
        "lng": -3.18916667
      },
      "km": 1.8,
