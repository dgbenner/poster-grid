    "pin": {
      "title": "Two Towers, Bologna",
      "description": "12th-century buildings in Bologna, Italy",
      "extract": "The Two Towers, both leaning, are symbols of Bologna, Italy, and the most prominent of the Towers of Bologna. They are located at the intersection of the roads that lead to the five gates of the old ring wall. The taller one is the Asinelli; the smaller, with a greater lean, is the Garisenda. They are named for the families which are traditionally credited with having constructed them between 1109 and 1119.",
      "url": "https://en.wikipedia.org/wiki/Two_Towers%2C_Bologna",
      "coordinates": {
        "lat": 44.4943,
        "lng": 11.3468
      },
      "km": 0,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/3/3b/Asinelli_e_Garisenda.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Bologna",
      "description": "Capital and largest city of Emilia-Romagna, Italy",
      "extract": "Bologna is the capital and largest city of the Emilia-Romagna region in northern Italy. It is the seventh most populous city in Italy, with 391,473 inhabitants from 150 different nationalities. Its metropolitan province is home to more than 1 million people as of 2026. Bologna is most famous for being the home to the oldest university in continuous operation, the University of Bologna, established in AD 1088.",
      "url": "https://en.wikipedia.org/wiki/Bologna",
      "coordinates": {
        "lat": 44.49388889,
        "lng": 11.34277778
      },
      "km": 0.3,
      "matchedBy": "title",
      "leadImage": "https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dd/Torri_di_Bologna%2C_Bologna.jpg/3840px-Torri_di_Bologna%2C_Bologna.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "source": "Wikipedia"
    }
