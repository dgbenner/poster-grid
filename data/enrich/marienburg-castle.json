    "pin": {
      "title": "Marienburg Castle (Hanover)",
      "description": "Castle in Lower Saxony, Germany",
      "extract": "Marienburg Castle is a Gothic Revival castle in Lower Saxony, Germany. It is located 15 kilometres (9.3 mi) north-west of Hildesheim, and around 30 kilometres (19 mi) south of Hanover, in the municipality of Pattensen. A summer residence of the House of Welf in the past, it is now owned by the Marienburg Castle Foundation chaired by former owner Ernst August of Hanover but publicly funded in part by the state of Lower Saxony.",
      "url": "https://en.wikipedia.org/wiki/Marienburg_Castle_(Hanover)",
      "coordinates": {
        "lat": 52.17229,
        "lng": 9.7665
      },
      "km": 10.6,
      "matchedBy": "search",
      "leadImage": "https://thumb.wikimedia.org/wikipedia/commons/thumb/8/87/Schloss_Marienburg_im_herbstlichen_Abendlicht.jpg/3840px-Schloss_Marienburg_im_herbstlichen_Abendlicht.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Gronau, Lower Saxony",
      "description": "Town in Lower Saxony, Germany",
      "extract": "Gronau is a town and a municipality in the district of Hildesheim, in Lower Saxony, Germany. It is situated on the River Leine, approximately 15 km southwest of Hildesheim, and 35 km south of Hanover. Since 1 November 2016, the former municipalities Banteln, Betheln, Brüggen, Despetal and Rheden are part of the municipality Gronau.",
      "url": "https://en.wikipedia.org/wiki/Gronau%2C_Lower_Saxony",
      "coordinates": {
        "lat": 52.06666667,
        "lng": 9.78333333
      },
      "km": 3.5,
