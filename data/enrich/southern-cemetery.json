    "pin": {
      "title": "Southern Cemetery, Manchester",
      "description": "Large cemetery in Manchester, England",
      "extract": "Southern Cemetery is a large municipal cemetery in Chorlton-cum-Hardy, Manchester, England, 3 miles (4.8 km) south of the city centre. It opened in 1879 and is owned and administered by Manchester City Council. It is the largest municipal cemetery in the United Kingdom and the second largest in Europe.",
      "url": "https://en.wikipedia.org/wiki/Southern_Cemetery%2C_Manchester",
