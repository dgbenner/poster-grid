    "pin": {
      "title": "Cinque Terre",
      "description": "Rugged portion of coast on the Italian Riviera, Liguria",
      "extract": "The Cinque Terre is a coastal area within Liguria, in the northwest of Italy. It lies in the west of La Spezia Province, and comprises five villages: Monterosso al Mare, Vernazza, Corniglia, Manarola and Riomaggiore. The coastline, the five villages, and the surrounding hillsides are all part of the Cinque Terre National Park, a UNESCO World Heritage Site. Vernazza is also one of \"I Borghi più belli d'Italia\".",
      "url": "https://en.wikipedia.org/wiki/Cinque_Terre",
      "coordinates": {
        "lat": 44.11944444,
        "lng": 9.71666667
      },
      "km": 1.1,
      "matchedBy": "title",
      "leadImage": "https://thumb.wikimedia.org/wikipedia/commons/thumb/7/70/Cinque_Terre_%28Italy%2C_October_2020%29_-_24_%2850543603956%29.jpg/3840px-Cinque_Terre_%28Italy%2C_October_2020%29_-_24_%2850543603956%29.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Corniglia",
      "description": "Hamlet in Vernazza, Italy",
      "extract": "Corniglia is a frazione (\"hamlet\") within the comune of Vernazza in the province of La Spezia, Liguria, northern Italy, with a population of about 150. Unlike the other localities of the Cinque Terre, Corniglia is not directly adjacent to the sea. Instead, it is on the top of a promontory about 100 metres high, surrounded on three sides by vineyards and terraces, the fourth side descends steeply to the sea. To reach Corniglia, it is necessary to climb the Lardarina, a long brick flight of steps composed of 33 flights with 383 steps or, otherwise follow a vehicular road that, from the station, leads to the village. Sometimes a small bus runs.",
      "url": "https://en.wikipedia.org/wiki/Corniglia",
      "coordinates": {
        "lat": 44.11972222,
        "lng": 9.70861111
      },
      "km": 0.8,
      "matchedBy": "title",
      "leadImage": "https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6c/East_Above_Corniglia_Cinque_Terre_Sep23_A7C_06797.jpg/3840px-East_Above_Corniglia_Cinque_Terre_Sep23_A7C_06797.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "source": "Wikipedia"
    }
