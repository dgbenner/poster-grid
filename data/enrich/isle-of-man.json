      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/b/b6/Castle_Rushen.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    }
