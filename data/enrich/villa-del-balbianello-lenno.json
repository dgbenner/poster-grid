    "town": {
      "title": "Tremezzina",
      "description": "Comune in Lombardy, Italy",
      "extract": "Tremezzina is a comune in the province of Como, in Lombardy, that formed on 25 May 2014 from a merger of the comunes of Lenno, Mezzegra, Ossuccio and Tremezzo.",
      "url": "https://en.wikipedia.org/wiki/Tremezzina",
