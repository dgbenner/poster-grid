  "facts": {
    "pin": {
      "title": "Brittany",
      "description": "Cultural area in northwestern France",
      "extract": "Brittany is a peninsula, historical region and cultural area in the north-west of modern France, covering the western part of what was known as Armorica in Roman Gaul. It became an independent kingdom and then a duchy before being united with the Kingdom of France in 1532 as a province governed as a separate nation under the crown. Brittany is the traditional homeland of the Breton people and is one of the six Celtic nations, retaining a distinct cultural identity that reflects its history.",
      "url": "https://en.wikipedia.org/wiki/Brittany",
      "coordinates": {
        "lat": 48,
        "lng": -3
      },
      "km": 23.4,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/1/18/Satellite_picture_of_Brittany_-_NASA%2C_2002.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Guerlédan",
      "description": "Commune in Brittany, France",
      "extract": "Guerlédan is a commune in the department of Côtes-d'Armor, western France. The municipality was established on 1 January 2017 by merger of the former communes of Mûr-de-Bretagne and Saint-Guen. This commune chose its name in reference to the Lake Guerlédan which is on its territory.",
      "url": "https://en.wikipedia.org/wiki/Guerl%C3%A9dan",
      "coordinates": {
        "lat": 48.201,
        "lng": -2.985
      },
      "km": 6.3,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/b/bc/M%C3%BBr-de-Bretagne_-_mairie.JPG?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    }
  },
  "note": {
    "text": "Northwesternmost France; rugged coast, the blush-toned Pink Granite Coast, walled Saint-Malo, chic Dinard, abundant prehistoric menhirs. Capital Rennes.",
