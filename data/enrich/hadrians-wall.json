    "pin": {
      "title": "Hadrian's Wall",
      "description": "Defensive fortification in Roman Britain",
      "extract": "Hadrian's Wall is a former defensive fortification of the Roman province of Britannia, begun in AD 122 in the reign of the Emperor Hadrian. Running from Wallsend on the River Tyne in the east to Bowness-on-Solway in the west of what is now northern England, it was a stone wall with large ditches in front and behind, stretching across the whole width of the island. Soldiers were garrisoned along the line of the wall in large forts, smaller milecastles, and intervening turrets. In addition to the wall's defensive military role, its gates may have been customs posts.",
      "url": "https://en.wikipedia.org/wiki/Hadrian's_Wall",
      "coordinates": {
        "lat": 55.01666667,
        "lng": -2.28333333
      },
      "km": 3.1,
      "matchedBy": "title",
      "leadImage": "https://thumb.wikimedia.org/wikipedia/commons/thumb/c/ce/Hadrians_Wall_map.svg/960px-Hadrians_Wall_map.svg.png?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Bardon Mill",
      "description": "Village in Northumberland, England",
      "extract": "Bardon Mill is a small village in Northumberland, within the vicinity of the ancient Hadrian's Wall. It is located around 10+1⁄2 miles from Hexham, 26+1⁄2 mi (43 km) from Carlisle, and 32 mi (51 km) from Newcastle upon Tyne.",
      "url": "https://en.wikipedia.org/wiki/Bardon_Mill",
      "coordinates": {
        "lat": 54.975,
        "lng": -2.337
      },
      "km": 4.2,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/b/bf/Bardon_Mill_in_2007.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    }
  },
