  "facts": {
    "pin": {
      "title": "Goonhilly Satellite Earth Station",
      "description": "Radiocommunication site in Cornwall, England",
      "extract": "Goonhilly Satellite Earth Station is a large radiocommunication site located on Goonhilly Downs near Helston on the Lizard peninsula in Cornwall, Britain. Owned by Goonhilly Earth Station Ltd under a 999-year lease from BT Group plc, it was at one time the largest satellite earth station in the world, with more than 30 communication antennas and dishes in use. The site also links into undersea cable lines.",
      "url": "https://en.wikipedia.org/wiki/Goonhilly_Satellite_Earth_Station",
      "coordinates": {
        "lat": 50.04805556,
        "lng": -5.18194444
      },
      "km": 0.2,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/f/fb/Goonhilly2.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    },
    "town": {
      "title": "Mawgan-in-Meneage",
      "description": "Civil parish in Cornwall, England",
      "extract": "Mawgan-in-Meneage is a village and civil parish in Cornwall, England. It is within the Meneage district of The Lizard peninsula, south of Helston, in the former administrative district of Kerrier. Mawgan-in-Meneage lies within the Cornwall National Landscape. The parish population at the 2011 census was 1437.",
      "url": "https://en.wikipedia.org/wiki/Mawgan-in-Meneage",
      "coordinates": {
        "lat": 50.08,
        "lng": -5.206
      },
      "km": 3.8,
      "matchedBy": "title",
      "leadImage": "https://upload.wikimedia.org/wikipedia/commons/1/11/St._Mawgan-in-Meneage_church_-_geograph.org.uk_-_418399.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled",
      "source": "Wikipedia"
    }
  },
  "note": {
    "text": "Historic satellite ground station on the Lizard, home to giant dishes that carried the first Telstar transatlantic TV link.",
