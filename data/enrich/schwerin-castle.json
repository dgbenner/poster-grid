      "source": "Wikipedia"
    },
    "town": {
      "title": "Schwerin",
      "description": "Capital of Mecklenburg-Vorpommern, Germany",
      "extract": "Schwerin is the capital and second-largest city of the northeastern German state of Mecklenburg-Vorpommern as well as of the region of Mecklenburg, after Rostock. It has around 96,000 inhabitants, and is thus the least populous of all German state capitals.",
      "url": "https://en.wikipedia.org/wiki/Schwerin",
      "coordinates": {
