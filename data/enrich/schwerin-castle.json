    "pin": {
      "title": "Schwerin Castle",
      "description": "Castle in Germany, Schwerin Lake",
      "extract": "Schwerin Castle (German: Schweriner Schloss, German pronunciation: [ʃveˈʁiːnɐ ˈʃlɔs] also known as Schwerin Palace, is a 19th-century Schloss built in the historicist style located in the city of Schwerin, the capital of Mecklenburg-Vorpommern state, Germany. It is situated on an island in the city's main lake, Lake Schwerin.",
      "url": "https://en.wikipedia.org/wiki/Schwerin_Castle",
